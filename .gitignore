bin/
*.test
*.out
*.prof

# go build ./... drops binaries here. Leading slash matters, otherwise this
# also matches the cmd/fastvec-bench/ directory and hides the source.
/fastvec-bench
/fastvec-build
/fastvec-server
/fastvec-subset

# datasets go in /mnt/d/data, not in here
*.fvecs
*.ivecs
*.tar.gz

# except the ground truth for the 100k subset. It's 400K and without it nobody
# can reproduce a recall number without downloading the full 168 MB dataset.
!bench/data/*.ivecs

# saved indexes. A SIFT1M one is around 550 MB.
*.fvi

py/.venv/
__pycache__/
